PORT=3000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=surplus_to_shelter
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Optional: creates the first admin if the account does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true only when intentionally replacing every seeded collection.
SEED_ALLOW_DESTRUCTIVE=false
